# Add these keys to the Developer Hub repository-root .env.
# Keep the DB_* values already used by the other memory notebooks.
# A folder-local .env is also supported and takes precedence over the root file.
DB_USER=
DB_PASSWORD=
DB_DSN=localhost:1521/FREEPDB1
PG_DSN="host=127.0.0.1 port=5547 dbname=pg_oracle user=postgres password=your_local_password"
# Only needed if BGE_RERANKER is absent:
# RERANKER_ONNX_FILE=/absolute/path/to/bge_reranker_base.onnx
# Optional local embedding file instead of the automatic MiniLM download:
# EMBEDDING_ONNX_FILE=/absolute/path/to/all_MiniLM_L12_v2.onnx
# Optional native DDS demo on a local development Oracle Free container:
# PG_ORACLE_DDS_CONTAINER=oracle-free
# PG_ORACLE_DDS_PDB=FREEPDB1
